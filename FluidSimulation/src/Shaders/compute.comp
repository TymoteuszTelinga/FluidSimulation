layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main()
{
	uint index = gl_GlobalInvocationID.x;
	Particle p = particles[index];

	//aply grawity
	p.velocity += vec3(0.f, 1.f, 0.f) * 9.81f * push.deltaTime;

	//calculate density
	//sync threds

	//calculate preshure
	vec3 pressureGradient = CalculateGradient(p.position);
	vec3 acceleration = pressureGradient / CalculateDensity(p.position);
	p.velocity = acceleration * push.deltaTime;

	p.position += p.velocity * push.deltaTime;

	ResolveCollisions(p);
	
	particles[index] = p;
}