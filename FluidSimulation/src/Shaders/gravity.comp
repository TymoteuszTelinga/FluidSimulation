float ConvertDensityToPresure(float density)
{
	float densityError = density - u_Spec.TargetDensity ;//?????????
	float pressure = densityError * u_Spec.PressureMultiplier;
	return pressure;
}

float CalculateSharedPressure(float densityA, float densityB)
{
    float preshureA = ConvertDensityToPresure(densityA);
    float preshureB = ConvertDensityToPresure(densityB);
    return (preshureA + preshureB) / 2.f;
}

vec2 CalculateGradient(vec2 samplePoint)
{
	vec2 gradient = vec2(0.f);

	const float mass = 1.f; //ubo
    const float particleDensity = particles[gl_GlobalInvocationID.x].density;
	
	for (uint i = 0; i < u_Spec.ParticlesCount; i++)
	{
		if (i == gl_GlobalInvocationID.x)
		{
			continue;
		}
        vec2 offset = particles[i].position - samplePoint;
		float dst = length(offset);
		vec2 dir = dst == 0.f ? vec2(0.f, 1.f) : offset / dst;
		float slope = SmoothingKernelDerivative(u_Spec.Radius, dst);

		float density = particles[i].density;
        float sharedPressure = CalculateSharedPressure(particleDensity, density);
		gradient += sharedPressure * dir * mass * slope / density;
	}

	return gradient;
}


layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main()
{
	uint index = gl_GlobalInvocationID.x;
	Particle p = particles[index];

	//calculate preshure
	vec2 pressureGradient = CalculateGradient(p.predictedPosition);
	vec2 acceleration = pressureGradient / p.density;
	p.velocity += acceleration * push.deltaTime;

	p.position += p.velocity * push.deltaTime;

	ResolveCollisions(p);
	
	particles[index] = p;
}