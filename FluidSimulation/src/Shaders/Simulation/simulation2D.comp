#version 460 core
#extension GL_ARB_shading_language_include : require

#include "Kernels.glsl"
#include "SpatialHash.glsl"

struct Particle
{
	vec3 position;
	float density;
	vec3 velocity;
    vec3 predictedPosition;
};

layout(push_constant) uniform Push
{
	float deltaTime;
} push;

layout(std140, binding = 0) uniform SimulationSpec
{
    float Width;
    float Height;
    float Depth;
    float CollisionDamping;
    float Radius;
    float TargetDensity;
    float PressureMultiplier;
    float ViscosityStrength;
    int ParticlesCount;
    int CollisionObjects;
} u_Spec;

layout(std140, binding = 1) buffer ParticleSSBO
{
	Particle particles[];
};

layout(std430, binding = 2) buffer SpatialIndices
{
	uvec2 indexes[];//key, particle index;
};

layout(std430, binding = 3) buffer SpatialLookUp
{
	uint LookUp[];
};

struct Object
{
    mat4 transform;
    vec3 color;
    float useCollision;
};

layout(std430, binding = 5) buffer ObjectsBuffer
{
	Object objects[];
};

//--------------HelperFunctions--------------

float CalculateDensity(vec3 samplePoint)
{
    ivec3 particleCell = GetCell3D(samplePoint, u_Spec.Radius);
	float density = 0.f;
	const float mass = 1.f; //ubo

    for (uint i = 0; i < 27; i++)
    {
        const uint hash = HashCell3D(particleCell + offsets3D[i]);
        const uint key = KeyFromHash(hash, u_Spec.ParticlesCount);
        uint spatialIndex = LookUp[key];

        while (spatialIndex < u_Spec.ParticlesCount)
        {
            uvec2 indexData = indexes[spatialIndex];
            spatialIndex++;

            //Exit if no longer looking at correct bin
            if(indexData.r != key) break;

            uint particleID = indexData.g;

            float dst = length(particles[particleID].predictedPosition - samplePoint);

            if (dst >= u_Spec.Radius) continue;

            float influance = SmoothingKernel(u_Spec.Radius, dst);
            density += mass * influance;
        }
    }

	return density;
}

float PressureFromDensity(float density)
{
	return (density - u_Spec.TargetDensity) * u_Spec.PressureMultiplier;
}

float SDFBox(vec3 point)
{
    const vec3 center = vec3(0.f);
    const vec3 size = vec3(1.f);
    vec3 d = abs(point - center) - size;
    return length(max(d, 0.0)) + min(max(d.x, max(d.y, d.z)), 0.0);
}

vec3 BoxNormal(vec3 position)
{
    const vec3 center = vec3(0.f);
    const vec3 size = vec3(1.f);
    vec3 relPos = position - center;
    
    vec3 d = abs(relPos) - size;
    
    // Determine which face is closest
    if(d.x > d.y && d.x > d.z) {
        return vec3(sign(relPos.x), 0.0, 0.0);
    } else if(d.y > d.z) {
        return vec3(0.0, sign(relPos.y), 0.0);
    } else {
        return vec3(0.0, 0.0, sign(relPos.z));
    }
}

bool checkBoxCollision(vec3 position, mat4 box, out vec3 normal, out float penetration) 
{
    // Transform particle position to box local space
    vec3 localPosition = (inverse(box) * vec4(position, 1.0)).xyz;
    float distance = SDFBox(localPosition);
    
    if(distance < 0.f) 
    {
        penetration = abs(distance);

        vec3 localNormal = BoxNormal(localPosition);
        normal = normalize((box * vec4(localNormal, 0.0)).xyz);
        return true;
    }
    return false;
}

void ResolveCollisions(inout Particle p)
{
	const float halfHeight = u_Spec.Height;
	const float halfWidth = u_Spec.Width;
    const float halfDepth = u_Spec.Depth;
	const float CollisionDamping = u_Spec.CollisionDamping;

	if ( abs(p.position.x) >= halfWidth)
	{
		p.position.x = halfWidth * sign(p.position.x);
		p.velocity.x *= -1 * CollisionDamping;
	}

	if ( abs(p.position.y) >= halfHeight)
	{
		p.position.y = halfHeight * sign(p.position.y);
		p.velocity.y *= -1 * CollisionDamping;
	}

    if ( abs(p.position.z) >= halfDepth)
	{
		p.position.z = halfDepth * sign(p.position.z);
		p.velocity.z *= -1 * CollisionDamping;
	}

    for(int i = 0; i < u_Spec.CollisionObjects; i++)
    {
        if(objects[i].useCollision <= 0.f)
        {
            continue;
        }

        float CollisionPenetration = 0.f;
        vec3 CollisionNormal = vec3(0.f);
        if ( checkBoxCollision(p.position, objects[i].transform, CollisionNormal, CollisionPenetration))
        {
            p.position += CollisionNormal * CollisionPenetration;
            p.velocity = reflect(p.velocity, CollisionNormal) * CollisionDamping;
        }
    }
}

//--------------EntryPoints--------------
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void ExternalForce()
{
	uint index = gl_GlobalInvocationID.x;
	Particle p = particles[index];

	//Apply gravity
	p.velocity += vec3(0.f, 1.f, 0.f) * 9.81f * push.deltaTime;//ubo
    //Predict position
    p.predictedPosition = p.position + (p.velocity * 1.f / 120.f);
	
	particles[index] = p;

    //updateSpatialHash
    ivec3 cell = GetCell3D(p.predictedPosition, u_Spec.Radius);
    uint hash = HashCell3D(cell);
    uint key = KeyFromHash(hash, u_Spec.ParticlesCount);

    indexes[index] = uvec2(key, index);
    LookUp[index] = -1;

}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void DensityStep()
{
    uint index = gl_GlobalInvocationID.x;
	Particle p = particles[index];
    //calculate density
    p.density = CalculateDensity(p.predictedPosition);

    particles[index] = p;
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void PressureStep()
{
    uint index = gl_GlobalInvocationID.x;
	Particle p = particles[index];

    const vec3 samplePoint = p.predictedPosition;
    const float particleDensity = p.density;
    const float particlePressure = PressureFromDensity(particleDensity);

    vec3 pressureForce = vec3(0.f);

    const ivec3 particleCell = GetCell3D(samplePoint, u_Spec.Radius);
    for (uint i = 0; i < 27; i++)
    {
        const uint hash = HashCell3D(particleCell + offsets3D[i]);
        const uint key = KeyFromHash(hash, u_Spec.ParticlesCount);
        uint spatialIndex = LookUp[key];

        while (spatialIndex < u_Spec.ParticlesCount)
        {
            uvec2 indexData = indexes[spatialIndex];
            spatialIndex++;

            //Exit if no longer looking at correct bin
            if(indexData.r != key) break;

            uint particleID = indexData.g;
            if (particleID == index) continue;

            //calculate custom property
            vec3 offset = particles[particleID].predictedPosition - samplePoint;
            float dst = length(offset);

            if (dst >= u_Spec.Radius) continue;

            vec3 dir = dst == 0.f ? vec3(0.f, 1.f, 0.f) : offset / dst;

            float slope = SmoothingKernelDerivative(u_Spec.Radius, dst);

            float neighbourDensity = particles[particleID].density;
            float pressure = PressureFromDensity(neighbourDensity);
            float sharedPressure = (particlePressure + pressure) / 2.f;
            pressureForce +=  dir * slope * sharedPressure / neighbourDensity;
        }
    }

    vec3 acceleration = pressureForce / particleDensity;
    p.velocity += acceleration * push.deltaTime;

    particles[index] = p;
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void ViscosityStep()
{
    uint index = gl_GlobalInvocationID.x;
	Particle p = particles[index];

    const vec3 samplePoint = p.predictedPosition;
    const vec3 velocity = p.velocity;
    // const float viscosityStrength = 0.06f;//ubo

    vec3 viscosityForce = vec3(0.f);

    const ivec3 particleCell = GetCell3D(samplePoint, u_Spec.Radius);
    for (uint i = 0; i < 27; i++)
    {
        const uint hash = HashCell3D(particleCell + offsets3D[i]);
        const uint key = KeyFromHash(hash, u_Spec.ParticlesCount);
        uint spatialIndex = LookUp[key];

        while (spatialIndex < u_Spec.ParticlesCount)
        {
            uvec2 indexData = indexes[spatialIndex];
            spatialIndex++;

            //Exit if no longer looking at correct bin
            if(indexData.r != key) break;

            uint particleID = indexData.g;
            if (particleID == index) continue;

            //calculate custom property
            vec3 offset = particles[particleID].predictedPosition - samplePoint;
            float dst = length(offset);

            if (dst >= u_Spec.Radius) continue;

            float slope = SmoothingKernel6(u_Spec.Radius, dst);

            vec3 neighbourVelocity = particles[particleID].velocity;
            viscosityForce += (neighbourVelocity - velocity) * slope;
        }
    }

    p.velocity += viscosityForce * u_Spec.ViscosityStrength * push.deltaTime;

    particles[index] = p;
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void UpdateStep()
{
    uint index = gl_GlobalInvocationID.x;
	Particle p = particles[index];

    p.position += p.velocity * push.deltaTime;

	ResolveCollisions(p);

    particles[index] = p;
}