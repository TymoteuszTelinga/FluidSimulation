const vec3 SunDirection = normalize(vec3(-1.f, -1.f, -1.f));
const float densityMultiplayer = 0.001f;

const vec3 BoxCenter = vec3(0.f, 0.f, 0.f);
const vec3 BoxSize = vec3(1.f, 16.f, 1.f);

const vec3 FloorCenter = vec3(0.f, 16.f, 0.f);
const vec3 FloorSize = vec3(20.f, 0.1f, 20.f);

//--------------Defines--------------
const float FLT_MAX = 3.402823466e+38;

struct Ray 
{
    vec3 origin;
    vec3 direction;
};

struct HitInfo 
{
    bool didHit;
    float densityAlongRay;
    float distance; //debug informations
    vec3 hitPoint;
    vec3 normal;
};

struct LightResponse
{
    vec3 reflectDir;
    float reflectWeight;
    vec3 refractDir;
    float refractWeight;
};

//--------------HelperFunctions--------------
bool intersectBox(Ray ray, out float d_min, out float d_max) 
{
    // Calculate intersection with each pair of planes along each axis
    vec3 invDir = 1.0 / ray.direction;
    vec3 d1 = (-vec3(13.f, 16.f, 5.f) - ray.origin) * invDir;
    vec3 d2 = ( vec3(13.f, 16.f, 5.f) - ray.origin) * invDir;
    
    // Find closest and furthest intersection for each axis
    vec3 tmin = min(d1, d2);
    vec3 tmax = max(d1, d2);
    
    // Find the largest tmin and smallest tmax
    d_min = max(max(tmin.x, tmin.y), tmin.z);
    d_max = min(min(tmax.x, tmax.y), tmax.z);
    
    // Ray intersects box if t_max >= t_min and t_max > 0
    return d_max >= d_min && d_max > 0.0;
}

HitInfo UnitBox(Ray ray) 
{
    // Calculate intersection with each pair of planes along each axis
    vec3 invDir = 1.0 / ray.direction;
    vec3 d1 = (vec3(-1.f) - ray.origin) * invDir;
    vec3 d2 = ( vec3(1.f) - ray.origin) * invDir;
    
    // Find closest and furthest intersection for each axis
    vec3 tmin = min(d1, d2);
    vec3 tmax = max(d1, d2);
    
    // Find the largest tmin and smallest tmax
    float d_min = max(max(tmin.x, tmin.y), tmin.z);
    float d_max = min(min(tmax.x, tmax.y), tmax.z);

    HitInfo hitInfo;
    // Ray intersects box if t_max >= t_min and t_max > 0
    hitInfo.didHit = d_max >= d_min && d_max > 0.0;
    hitInfo.distance = FLT_MAX;

    if (hitInfo.didHit)
    {
        hitInfo.distance = d_min;
        hitInfo.hitPoint = ray.origin + ray.direction * d_min;

        vec3 o = (1 - abs(hitInfo.hitPoint));
        vec3 absNormal = (o.x < o.y && o.x < o.z) ? vec3(1.f, 0.f, 0.f) : (o.y < o.z) ? vec3(0.f, 1.f, 0.f) : vec3(0.f, 0.f, 1.f);
        hitInfo.normal = absNormal * sign(hitInfo.hitPoint);
    }

    return hitInfo;
}

HitInfo AABox(Ray ray, vec3 center, vec3 size)
{
    Ray unitBoxRay;
    unitBoxRay.origin = (ray.origin - center) / size;
    unitBoxRay.direction = ray.direction / size;

    HitInfo hitInfo = UnitBox(unitBoxRay);
    hitInfo.hitPoint = hitInfo.hitPoint * size + center;
    if (hitInfo.didHit)
    {
        hitInfo.distance = length(hitInfo.hitPoint - ray.origin);
    }
    return hitInfo;
}

Ray WorldRayToLocal(Ray ray, mat4 Transform)
{
    return Ray((Transform * vec4(ray.origin, 1.0)).xyz, (Transform * vec4(ray.direction, 0.0)).xyz);
}

vec3 LocalToWorld(vec4 vec, mat4 Transform)
{
    return (Transform * vec).xyz;
}

HitInfo RayBox(Ray ray, mat4 box)
{
    Ray localRay = WorldRayToLocal(ray, box);
    HitInfo hitResoult = UnitBox(localRay);
    
    hitResoult.normal = normalize(LocalToWorld(vec4(hitResoult.normal, 0), inverse(box)));
    hitResoult.hitPoint = LocalToWorld(vec4(hitResoult.hitPoint, 1), inverse(box));
    if(hitResoult.didHit)
    {
        hitResoult.distance = length(ray.origin - hitResoult.hitPoint);
    }
    return hitResoult;
}

// Simple sky color
vec3 getSkyColor(Ray ray) 
{
    const vec3 colGround = vec3(0.35, 0.3, 0.35) * 0.53;
    const vec3 colSkyHorizon = vec3(1, 1, 1);
    const vec3 colSkyZenith = vec3(0.08, 0.37, 0.73);

    float sun = pow(max(0, dot(ray.direction, SunDirection)), 50);
    float skyGradientT = pow(smoothstep(0, 0.4, -ray.direction.y), 0.35);
    float groundToSkyT = smoothstep(-0.01, 0, -ray.direction.y);
    vec3 skyGradient = mix(colSkyHorizon, colSkyZenith, skyGradientT);

    float a = groundToSkyT >= 1 ? 1.f : 0.f;
    return mix(colGround, skyGradient, groundToSkyT) + vec3(sun * a);
}

// Compute SPH density at current position
float SampleDensity(vec3 samplePoint)
{
    //-1.f <-> 1.f
    vec3 textureCoord = samplePoint / vec3(13.f, 16.f, 5.f);
    //0.f <-> 1.f;
    textureCoord = (textureCoord + 1.f) / 2.f;
    
    const float iso_value = 0.2f * 105.75f;
    return texture(DensityVolume, textureCoord).r - iso_value;
}

vec3 CalculateClosestFaceNormal(vec3 pos)
{
    vec3 o = (vec3(13.f, 16.f, 5.f)- abs(pos));
    vec3 normal;
    if (o.x < o.y && o.x < o.z)
    {
        normal = vec3(sign(pos.x), 0.f, 0.f);
    }
    else
    {
        if (o.y < o.z)
        {
            normal = vec3(0.f, sign(pos.y), 0.f);
        }
        else
        {
            normal = vec3(0.f, 0.f, sign(pos.z));
        }
    }
    return normal;
}

vec3 CalculateNormal(vec3 pos)
{
    const float s = 0.1f;
    vec3 offsetX = vec3(1.f, 0.f, 0.f) * ubo.samplingStep;
    vec3 offsetY = vec3(0.f, 1.f, 0.f) * ubo.samplingStep;
    vec3 offsetZ = vec3(0.f, 0.f, 1.f) * ubo.samplingStep;

    float dx = SampleDensity(pos - offsetX) - SampleDensity(pos + offsetX);
    float dy = SampleDensity(pos - offsetY) - SampleDensity(pos + offsetY);
    float dz = SampleDensity(pos - offsetZ) - SampleDensity(pos + offsetZ);

    vec3 volumeNormal = normalize(vec3(dx,dy,dz));

    vec3 o = vec3(13.f, 16.f, 5.f) - abs(pos);
    float faceWeight = min(o.x, min(o.y, o.z));
    vec3 faceNormal = CalculateClosestFaceNormal(pos);

    const float smoothDst = 0.3f;
    const float smoothPow = 5.f;
    faceWeight = (1.f - smoothstep(0, smoothDst, faceWeight)) * (1.f-pow(clamp(volumeNormal.y, 0.f, 1.f), smoothPow));

    return normalize(volumeNormal * (1.f - faceWeight) + faceNormal * (faceWeight));
}

vec3 refineHitPosition(vec3 position, vec3 direction, float stepsize)
{
    for (int i = 0; i < 0; i++)
    {
        stepsize /= 2.f;
        position += -direction * stepsize;
        float density = SampleDensity(position);
        if (density <= 0)
        {
            stepsize *= -1.f;
        }
    }
    return position;
}

bool IsInsideFluid(vec3 position)
{
    float density = SampleDensity(position);
    return density > 0.f;
}

float CalculateDensityAlongRay(vec3 origin, vec3 direction, float stepSize)
{
    Ray ray;
    ray.origin = origin;
    ray.direction = direction;
    if (dot(ray.direction, ray.direction) < 0.9f)
        return 0.f;
    
    float dMin, dMax;
    if(!intersectBox(ray, dMin, dMax))
    {
        return 0.f;
    }

    float totalDenisty = 0.f;
    dMin = max(0.f, dMin);
    for (float d = dMin + 0.01f; d <= dMax; d += stepSize)
    {
        vec3 position = ray.origin + ray.direction * d;
        float density = SampleDensity(position) * stepSize * densityMultiplayer;
        if (density > 0.f)
        {
            totalDenisty += density;
        }
    }
    return totalDenisty;
}

vec3 Enviroment(vec3 position, vec3 direction)
{
    Ray ray;
    ray.origin = position;
    ray.direction = direction;

    //HitInfo floorHit = AABox(ray, vec3(0.f, 10.f, 0.f), vec3(20.f, 0.01f, 20.f));
    HitInfo boxHit = AABox(ray, vec3(0.f, 10.f, 0.f), vec3(1.f, 10.0f, 1.f));
    if (boxHit.didHit)
    {
        return vec3(1.f, 1.f, 1.f);
    }

    const vec3 colGround = vec3(0.35, 0.3, 0.35) * 0.53;
    const vec3 colSkyHorizon = vec3(1, 1, 1);
    const vec3 colSkyZenith = vec3(0.08, 0.37, 0.73);

    float sun = pow(max(0, dot(direction, SunDirection)), 50);
    float skyGradientT = pow(smoothstep(0, 0.4, -direction.y), 0.35);
    float groundToSkyT = smoothstep(-0.01, 0, -direction.y);
    vec3 skyGradient = mix(colSkyHorizon, colSkyZenith, skyGradientT);

    float a = groundToSkyT >= 1 ? 1.f : 0.f;
    return mix(colGround, skyGradient, groundToSkyT) + vec3(sun * a);
}

float CalculateSurface(vec3 origin, vec3 direction, float maxStep, bool bFindFluid)
{
    if (!ubo.DynamicCalculations)
    {
       return 0.f;
    }

    float d;
    for(d = 0.001f; d <= maxStep; d+= 0.001f)
    {
        vec3 position = origin + direction * d;
        float density = SampleDensity(position);
        bool insideFluid = density > 0.f;
        if (insideFluid == bFindFluid)
        {
            break;
        }
    }
    return d;
}

HitInfo FindNextSurface(Ray ray, bool bFindNextEntry, float stepSize, float maxDistance)
{
    HitInfo closestHit;
    closestHit.didHit = false;
    closestHit.densityAlongRay = 0.f;
    closestHit.distance = 0.f;
    closestHit.hitPoint = vec3(0.f);
    closestHit.normal = vec3(0.f);

    float dMin, dMax;
    if(!intersectBox(ray, dMin, dMax))
    {
        return closestHit;
    }

    bool startInFluid = IsInsideFluid(ray.origin);
    vec3 lastPositionInFluid = ray.origin;
    // bool hasEnteredFluid = false;

    dMin = max(0.f, dMin);
    dMax = min(maxDistance, dMax);
    for (float d = dMin; d <= dMax; d += stepSize)
    {
        vec3 position = ray.origin + ray.direction * (d+stepSize);
        float density = SampleDensity(position) * stepSize * densityMultiplayer;
        bool insideFluid = density > 0.f;
        //found Boundry
        if (insideFluid != startInFluid)
        {
            vec3 position = ray.origin + ray.direction * d;
            float surfaceSDF = CalculateSurface(position, ray.direction, stepSize, !startInFluid);

            closestHit.didHit = true;
            closestHit.distance = (d + surfaceSDF);
            closestHit.hitPoint = ray.origin + ray.direction * (d + surfaceSDF);
            closestHit.densityAlongRay = SampleDensity(closestHit.hitPoint) * surfaceSDF * densityMultiplayer;
            break;
        }
        else
        {
            closestHit.densityAlongRay += max(0.f, density);
        }
    }

    if(!closestHit.didHit && startInFluid)
    {
        closestHit.didHit = true;
        closestHit.distance = dMax;
        closestHit.hitPoint = ray.origin + ray.direction * dMax;
    }

    // for (float d = dMin + 0.001f; d <= dMax; d += stepSize)
    // {
    //     bool isLastStep = d + stepSize >= dMax;
    //     vec3 position = ray.origin + ray.direction * d;
    //     float density = SampleDensity(position) * stepSize * densityMultiplayer;
    //     bool insideFluid = density > 0.f;
    //     if (insideFluid)
    //     {
    //         closestHit.densityAlongRay += density;
    //         lastPositionInFluid = position;
    //         hasEnteredFluid = true;
    //     }
    //     else
    //     {
    //         hasExittedFluid = true;
    //     }

    //     bool found;
    //     if (bFindNextEntry)
    //     {
    //         found = insideFluid && hasExittedFluid;
    //     }
    //     else
    //     {
    //         found = hasEnteredFluid && (!insideFluid || isLastStep);
    //     }

    //     if ( found )
    //     {
    //         closestHit.distance = d - dMin;
    //         closestHit.didHit = true;
    //         closestHit.hitPoint = lastPositionInFluid;
    //         break;
    //     }
    // }

    return closestHit;
}

// 1 <- reflect (odbicie)
// 0 <- refract (zagięcie)
float CalculateReflectance(vec3 dir, vec3 normal, float iorA, float iorB)
{
    float refractRatio = iorA / iorB;
    float cosAngle = -dot(dir, normal);
    float sinSqrAngleOfRefraction = refractRatio * refractRatio * (1 - cosAngle * cosAngle);
    if (sinSqrAngleOfRefraction >= 1.f)
    {
        return 1.f; //Ray is fully reflected, no refraction occurs
    }

    float cosAngleOfRefraction = sqrt(1.f - sinSqrAngleOfRefraction);
    // Perpendicular polarization
    float rPerpendicular = (iorA * cosAngle - iorB * cosAngleOfRefraction) / (iorA * cosAngle + iorB * cosAngleOfRefraction);
    rPerpendicular *= rPerpendicular;
    // Parallel polarization
    float rParallel = (iorB * cosAngle - iorA * cosAngleOfRefraction) / (iorB * cosAngle + iorA * cosAngleOfRefraction);
    rParallel *= rParallel;

    // Return the average of the perpendicular and parallel polarizations
    return (rPerpendicular + rParallel) / 2;
}

vec3 TraceEnviroment(Ray ray)
{
    HitInfo floorHit = AABox(ray, FloorCenter, FloorSize);
    HitInfo boxHit = AABox(ray, BoxCenter, BoxSize);
    // boxHit.didHit=false;

    if(boxHit.didHit && boxHit.distance < floorHit.distance)
    {
        Ray shadowRay;
        shadowRay.origin = boxHit.hitPoint;
        shadowRay.direction = SunDirection;
        bool bInShadow = AABox(shadowRay, FloorCenter, FloorSize).didHit;

        return vec3(0.9f, 1.0f, 0.9f) * (dot(boxHit.normal, SunDirection) * 0.5 + 0.5) * (bInShadow ? 0.2 : 1.f);
    }
    else if (floorHit.didHit)
    {
        vec3 floorColor = floorHit.hitPoint.x > 0 ? vec3(0.801f, 0.021f, 0.098f) : vec3(0.051f, 0.065f, 0.800f);
        if (floorHit.hitPoint.z < 0) floorColor = floorHit.hitPoint.x > 0 ? vec3(0.048f, 0.800f, 0.049f) : vec3(0.800f, 0.691f, 0.061f);

        Ray shadowRay;
        shadowRay.origin = floorHit.hitPoint;
        shadowRay.direction = SunDirection;

        vec3 shadowMap = exp(-CalculateDensityAlongRay(floorHit.hitPoint, SunDirection, 0.1f * 2.f) * 2.f * ubo.extinctionCoeff);
        bool bInShadow = AABox(shadowRay, BoxCenter, BoxSize).didHit;
        // bInShadow = false;
        if (bInShadow)
        {
            shadowMap *= 0.2f;
        }
        return floorColor * (dot(floorHit.normal, SunDirection) * 0.5 + 0.5) * shadowMap;
    }

    return getSkyColor(ray);
}

vec3 TraceObjects(Ray ray)
{
    HitInfo closestHit;
    closestHit.didHit = false;
    closestHit.distance = FLT_MAX;
    int ClosestObject = -1;

    for(int i = 0; i < ubo.objectsInScene; i++)
    {
        HitInfo objectHit = RayBox(ray, objects[i].transform);

        if(objectHit.distance < closestHit.distance)
        {
            closestHit = objectHit;
            ClosestObject = i;
        }
    }

    if(closestHit.didHit)
    {
        return objects[ClosestObject].color;
    }

    return vec3(0.f);
}

vec3 TraceSPH(Ray ray)
{
    HitInfo hit;
    hit.didHit = false;
    hit.distance = 0.f;
    hit.densityAlongRay = 0.f;
    hit.normal = vec3(0.f);

    LightResponse lightInfo;
    float remidingWeight = 1.f;

    vec3 Contribution = vec3(1.f);
    vec3 Light = vec3(0.f);

    bool bRayFromInsideFluid = IsInsideFluid(ray.origin);

    for (int i = 0; i < ubo.bounces; i++)
    {
        HitInfo boxHit = AABox(ray, BoxCenter, BoxSize);
        // boxHit.didHit = false;
        // boxHit.distance = FLT_MAX;
        hit = FindNextSurface(ray, !bRayFromInsideFluid, ubo.stepSize * (i+1), boxHit.distance);

        bool bUseBoxHit = boxHit.didHit && boxHit.distance <= hit.distance;
        if (!hit.didHit)
        {
            //transmittance *= Transmittance(CalculateDensityAlongRay(cubeHit.hitPoint, cubeHit.normal, densityStepSize));
            // Contribution *= exp(-hit.densityAlongRay * ubo.extinctionCoeff);
            // light += Light(rayPos, rayDir) * transmittance;
            // transmittance = 0;
            // Contribution = vec3(0.f);
            Light += TraceEnviroment(ray) * Contribution;
            Contribution = vec3(0.f);
            break;
        }

        Contribution *= exp(-hit.densityAlongRay * ubo.extinctionCoeff);

        if (bUseBoxHit)
        {
            Light += TraceEnviroment(ray) * Contribution;
            // Light = vec3(1.f, 0.f, 0.f);
            return Light;
        }

        hit.normal = CalculateNormal(hit.hitPoint);
        if (dot(hit.normal, ray.direction) > 0.f)
        {
            hit.normal = -hit.normal;
        }

        float iorA = bRayFromInsideFluid ? 1.333f : 1.f;
        float iorB = bRayFromInsideFluid ? 1.0f : 1.333f;

        //light info
        lightInfo.reflectWeight = CalculateReflectance(ray.direction, hit.normal, iorA, iorB);
        lightInfo.refractWeight = 1.f - lightInfo.reflectWeight;
        lightInfo.refractDir = refract(ray.direction, hit.normal, iorA / iorB);
        lightInfo.reflectDir = reflect(ray.direction, hit.normal);
        float refractDensity = CalculateDensityAlongRay(hit.hitPoint, lightInfo.refractDir, 0.1);
        float reflectDensity = CalculateDensityAlongRay(hit.hitPoint, lightInfo.reflectDir, 0.1);

        bool refractPath = lightInfo.refractWeight*refractDensity > lightInfo.reflectWeight*reflectDensity;
        // refractPath = true;

        if (refractPath)
        {
            //reflect light Aprximation
            //Light += Enviroment(ray.origin, lightInfo.reflectDir) * Contribution * exp(-reflectDensity*ubo.extinctionCoeff) * lightInfo.reflectWeight;
            ray.direction = lightInfo.reflectDir;
            Light += TraceEnviroment(ray) * Contribution * exp(-reflectDensity*ubo.extinctionCoeff) * lightInfo.reflectWeight;
            ray.direction = lightInfo.refractDir;
            remidingWeight = lightInfo.refractWeight;
        }
        else
        {
            //refract light Aprximation
            //Light += Enviroment(ray.origin, lightInfo.refractDir) * Contribution * exp(-refractDensity*ubo.extinctionCoeff) * lightInfo.refractWeight;
            ray.direction = lightInfo.refractDir;
            Light += TraceEnviroment(ray) * Contribution * exp(-refractDensity*ubo.extinctionCoeff) * lightInfo.refractWeight;
            ray.direction = lightInfo.reflectDir;
            remidingWeight = lightInfo.reflectWeight;
        }

        ray.origin = hit.hitPoint;
        bRayFromInsideFluid = refractPath != bRayFromInsideFluid;
    }

    // return vec3(hit.densityAlongRay + CalculateDensityAlongRay(ray.origin, ray.direction, 0.1));
    
    // if(!hit.didHit)
    // {
    //     Light += Enviroment(ray.origin, ray.direction) * Contribution * exp(-CalculateDensityAlongRay(ray.origin, ray.direction, 0.1)*ubo.extinctionCoeff);
    // }
    // else
    {
        // Light += Enviroment(ray.origin, ray.direction) * Contribution * exp(-CalculateDensityAlongRay(ray.origin, ray.direction, 0.1)*ubo.extinctionCoeff) * remidingWeight;
        Light += TraceEnviroment(ray) * Contribution * exp(-CalculateDensityAlongRay(ray.origin, ray.direction, 0.1)*ubo.extinctionCoeff) * remidingWeight;
    }
    //Light += Enviroment(ray.origin, ray.direction);

    // return vec3((hit.normal + 1.f) / 2.f);
    // return vec3(hit.densityAlongRay * 1000.f, hit.distance, 0.f);
    return Light;

    if(!hit.didHit)
    {
        return vec3(0.f);
    }

    hit.normal += 1.f;
    hit.normal *= 0.5f;
    return hit.normal;
}



